{
  "name": "altis-mcp",
  "version": "0.1.0",
  "description": "MCP server for Altis ASO (tryaltis.com): reads the local Altis macOS app database and queries the App Store for live keyword data.",
  "type": "module",
  "bin": { "altis-mcp": "dist/index.js" },
  "files": ["dist"],
  "engines": { "node": ">=22.13" },
  "scripts": {
    "build": "tsc",
    "dev": "node src/index.ts",
    "start": "node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
